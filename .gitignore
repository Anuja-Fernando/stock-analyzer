# --- Secrets (never commit) ---
.env
.env.*
!.env.example

# --- Python virtual environments ---
.venv/
.dbt-venv/

# --- Python build/cache files ---
__pycache__/
*.pyc
*.egg-info/
build/
dist/
.pytest_cache/

# --- Dagster local state (run history, logs, event DB) ---
.dagster_home/

# --- dbt generated files ---
dbt_project/target/
dbt_project/dbt_packages/
dbt_project/logs/
dbt_project/.user.yml

# --- Generated by the pipeline ---
reports/

# --- Frontend (Node / React / Vite) ---
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.vite/
frontend/coverage/
npm-debug.log*

# --- Editor / OS noise ---
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini